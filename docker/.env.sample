# Gmail SMTP 설정
# 주의: 다른 환경에서 사용할 때는 반드시 본인의 Gmail 정보로 변경하세요!
# EMAIL_HOST_PASSWORD는 Gmail 앱 비밀번호를 사용해야 합니다 (일반 비밀번호 아님)
# Gmail 앱 비밀번호 생성 방법:
# 1. Google 계정 관리 > 보안 > 2단계 인증 활성화
# 2. 앱 비밀번호 생성 > 메일 선택 > 16자리 비밀번호 생성
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# 다른 사용자는 아래 형식으로 본인의 정보를 입력하세요:
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password_here
WEATHER_API_KEY=""